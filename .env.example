# Copy to .env to override the defaults used by docker-compose.yml and scripts/.

# Database
POSTGRES_USER=bench
POSTGRES_PASSWORD=bench
POSTGRES_DB=products
POSTGRES_PORT=5432
PRODUCT_COUNT=100000

# Servers (same values for all three)
# DATA_SOURCE: postgres | memory
DATA_SOURCE=postgres
DB_MAX_CONNS=20
LOG_LEVEL=info
LOG_REQUESTS=false

# Host ports
GO_REST_PORT=8080
TS_REST_PORT=8081
GO_GRPC_PORT=9090
GO_REST_METRICS_PORT=9101
TS_REST_METRICS_PORT=9102
GO_GRPC_METRICS_PORT=9103

# Resource limits. Every API server gets the same limits.
SERVER_CPUS=2
SERVER_MEMORY=1g
POSTGRES_CPUS=4
POSTGRES_MEMORY=2g
K6_CPUS=4
